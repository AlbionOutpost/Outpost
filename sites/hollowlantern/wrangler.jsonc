// Hollow Lantern company site: static assets only. There is no `main` script, so requests are
// served straight from the asset store and never run billable Worker code.
{
  "name": "hollowlantern-site",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  "preview_urls": false,
  // hollowlantern.com and www are attached as Workers Custom Domains in the dashboard/API once,
  // so the CI deploy token only needs Workers Scripts Write.
}
