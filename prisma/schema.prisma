generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
 marketWatchItems MarketWatchItem[]
 timers Timer[]
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  role String @default("USER")
  region String @default("europe")
  characterName String?
  /// Profile picture frame the player picked (src/lib/avatar-frames.ts); null = plain picture.
  avatarFrame String?
  /// Supporter plan: FREE or SUPPORTER. Written only by the Stripe webhook; checked on the server.
  plan String @default("FREE")
  planStatus String?
  planRenewsAt DateTime?
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  /// Durable checkout intent and exact idempotent request; no payment credentials.
  billingCheckout Json?
  /// Staff gifts are independent of Stripe and expire without a background job.
  supporterGiftUntil DateTime?
  supporterGiftPermanent Boolean @default(false)
  bannedAt DateTime?
  bannedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  compositions Composition[]
  ownedGroups Group[]
  memberships GroupMember[]
  libraryLikes LibraryLike[]
  libraryFavorites LibraryFavorite[]
  masteryLevels MasteryLevel[]
  builds Build[]
  accounts Account[]
  sessions Session[]
  groupRequests GroupMembershipRequest[]
  groupRsvps EventRSVP[]

  authoredAnnouncements GroupAnnouncement[]
  authoredGroupEvents GroupEvent[]
  authoredGroupBuilds GroupBuild[]
  authoredLootSplits GroupLootSplit[]
  walletEntries GroupWalletEntry[] @relation("WalletHolder")
  walletChanges GroupWalletEntry[] @relation("WalletActor")
  calledFlips GroupCoinFlip[] @relation("FlipCaller")
  headsFlips GroupCoinFlip[] @relation("FlipHeads")
  tailsFlips GroupCoinFlip[] @relation("FlipTails")
  openedRolls GroupLootRoll[] @relation("RollOpener")
  wonRolls GroupLootRoll[] @relation("RollWinner")
  lootRolls GroupLootRollEntry[]
  issuedGroupInvites GroupInvitation[]

  savedScenarios SavedScenario[]

  buildFavorites BuildFavorite[]
  compositionFavorites CompositionFavorite[]
  buildVotes BuildVote[]
  comments ContentComment[]
  reports ContentReport[] @relation("ReportAuthor")
  reviewedReports ContentReport[] @relation("ReportReviewer")
  moderationLogs ModerationLog[]

}
model DiscordBan {
  discordId String @id
  reason String
  createdById String
  createdAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  version Int @default(1)
}
model AdminAudit {
  id String @id @default(cuid())
  /// Immutable actor/target identifiers; no OAuth credentials or session tokens.
  actorId String
  targetId String
  action String
  reason String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([targetId, createdAt])
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}

enum BuildVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}
model Build {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title String
  description String @db.Text
  contentType String
  region String
  visibility BuildVisibility @default(PRIVATE)
  playerCount Int @default(1)
  recommendedIP Int @default(0)
  strategy String @db.Text
  patchNotes String @db.Text
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  equipmentSets Json @default("[]")
  equipment BuildEquipment[]
  versions BuildVersion[]
  @@index([visibility, updatedAt])
  @@index([authorId, updatedAt])
  groupSnapshots GroupBuild[]

 hiddenAt DateTime?
 comments ContentComment[]
 reports ContentReport[]
 favorites BuildFavorite[]
 votes BuildVote[]

}
model BuildEquipment {
  id String @id @default(cuid())
  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  slot String
  itemId String
  quality Int
  abilities String @db.Text
  alternatives String @db.Text
  @@unique([buildId, slot])
  abilitySelections Json @default("{}")
  alternativeItemIds String[] @default([])

}
model BuildVersion {
  id String @id @default(cuid())
  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  version Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([buildId, version])
}

enum GroupRole {
 OWNER
 ADMIN
 OFFICER
 MEMBER
}
enum ContentVisibility {
 PUBLIC
 PRIVATE
 GROUP
}
model Group {
 id String @id @default(cuid())
 name String
 slug String @unique
 description String @db.Text
 region String
 visibility String @default("PRIVATE")
 /// Crest: an Albion item render on a palette colour (src/lib/groups/crest.ts); null = monogram.
 crestItem String?
 crestColor String?
 /// What the team plays: build activity names, stored ",ZvZ,Ganking," so a filter can match whole names.
 activities String @default("")
 /// Public teams take join requests only while recruiting.
 recruiting Boolean @default(true)
 /// Guild tax in percent (0–100, one decimal): loot splits can take it for the team pot first.
 guildTaxPercent Float @default(0)
 ownerId String
 owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 members GroupMember[]
 compositions Composition[]
 @@index([visibility,updatedAt])
 @@index([ownerId])
  invitations GroupInvitation[]
  requests GroupMembershipRequest[]
  announcements GroupAnnouncement[]
  events GroupEvent[]
  builds GroupBuild[]
  lootSplits GroupLootSplit[]
  roles GroupCustomRole[]
  walletEntries GroupWalletEntry[]
  coinFlips GroupCoinFlip[]
  lootRolls GroupLootRoll[]

}
model GroupMember {
 groupId String
 userId String
 /// Legacy fixed role, kept only as the source of the one-time role migration; rights come from `roles`.
 role GroupRole @default(MEMBER)
 joinedAt DateTime @default(now())
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 roles GroupRoleAssignment[]
 @@id([groupId,userId])
 @@index([userId])
}
/// A Team's own role: name, palette colour, place in the order and permission flags (src/lib/groups/permissions.ts).
model GroupCustomRole {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 name String
 color String @default("muted")
 /// Higher sits above; a member acts only on roles below their own highest.
 position Int
 /// Bit flags in `teamPermissions` order.
 permissions Int @default(0)
 /// The role every new member gets (at most one per team).
 isDefault Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 assignments GroupRoleAssignment[]
 @@unique([id,groupId])
 @@index([groupId,position])
}
model GroupRoleAssignment {
 groupId String
 userId String
 roleId String
 role GroupCustomRole @relation(fields:[roleId,groupId],references:[id,groupId],onDelete:Cascade)
 member GroupMember @relation(fields:[groupId,userId],references:[groupId,userId],onDelete:Cascade)
 @@id([roleId,userId])
 @@index([groupId,userId])
}
model Composition {
 id String @id @default(cuid())
 authorId String
 author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
 groupId String?
 group Group? @relation(fields:[groupId],references:[id],onDelete:Cascade)
 title String
 description String @db.Text
 region String
 contentType String
 visibility ContentVisibility @default(PRIVATE)
 slots Json
 notes String @db.Text
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 versions CompositionVersion[]
 @@index([authorId,updatedAt])
 @@index([visibility,updatedAt])
 @@index([groupId,updatedAt])
  events GroupEvent[]

 hiddenAt DateTime?
 comments ContentComment[]
 reports ContentReport[]
 favorites CompositionFavorite[]

}
model CompositionVersion {
 id String @id @default(cuid())
 compositionId String
 composition Composition @relation(fields:[compositionId],references:[id],onDelete:Cascade)
 version Int
 snapshot Json
 createdAt DateTime @default(now())
 @@unique([compositionId,version])
}

model GroupInvitation {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 tokenHash String @unique
 createdById String?
 createdBy User? @relation(fields:[createdById],references:[id],onDelete:SetNull)
 expiresAt DateTime
 acceptedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([groupId,createdAt])
}
model GroupMembershipRequest {
 groupId String
 userId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 status String @default("PENDING")
 message String @db.Text
 updatedAt DateTime @updatedAt
 @@id([groupId,userId])
 @@index([groupId,status])
}
model GroupAnnouncement {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 title String
 body String @db.Text
 authorId String?
 author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now())
 @@index([groupId,createdAt])
}
model GroupEvent {
 version Int @default(1)
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 title String
 description String @db.Text
 startsAt DateTime
 timezone String
 expectedParticipants Int
 voiceInfo String
 compositionId String?
 composition Composition? @relation(fields:[compositionId],references:[id],onDelete:SetNull)
 cancelled Boolean @default(false)
 authorId String?
 author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now())
 rsvps EventRSVP[]
 @@index([groupId,startsAt])
}
model EventRSVP {
 eventId String
 userId String
 event GroupEvent @relation(fields:[eventId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 status String
 role String
 updatedAt DateTime @updatedAt
 @@id([eventId,userId])
}
model GroupBuild {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 title String
 snapshot Json
 sourceBuildId String?
 sourceBuild Build? @relation(fields:[sourceBuildId],references:[id],onDelete:SetNull)
 authorId String?
 author User? @relation(fields:[authorId],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now())
 @@index([groupId,createdAt])
}

model SavedScenario {
 id String @id @default(cuid())
 authorId String
 author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
 title String
 kind String
 configuration Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([authorId,updatedAt])
}

model GroupLootSplit {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 title String
 configuration Json
 version Int @default(1)
 createdById String?
 createdBy User? @relation(fields:[createdById],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([groupId,updatedAt])
}

/// One change to a Team wallet, in whole in-game silver (bookkeeping only; Outpost moves no silver).
/// `userId` is the member whose balance changes, or null for the team pot; a balance is the sum of its entries.
model GroupWalletEntry {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 userId String?
 user User? @relation("WalletHolder",fields:[userId],references:[id],onDelete:Cascade)
 /// Signed whole silver: credits are positive; debits, payouts and resets negative.
 amount Float
 /// credit | debit | payout | reset | split | roll
 kind String
 reason String
 /// What made the change (`op:<client key>`, `split:<id>`, `roll:<id>`), so a retry never books twice.
 sourceId String
 createdById String?
 createdBy User? @relation("WalletActor",fields:[createdById],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now())
 @@unique([groupId,sourceId,userId])
 @@index([groupId,userId,createdAt])
 @@index([groupId,createdAt])
}
/// A coin flip decided on the server: two members (heads and tails) or one member calling a side.
/// It settles ties and decisions only: no stake, no silver moves.
model GroupCoinFlip {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 /// The caller's operation key: retrying the same flip returns the first result.
 key String
 createdById String?
 createdBy User? @relation("FlipCaller",fields:[createdById],references:[id],onDelete:SetNull)
 headsId String
 heads User @relation("FlipHeads",fields:[headsId],references:[id],onDelete:Cascade)
 tailsId String?
 tails User? @relation("FlipTails",fields:[tailsId],references:[id],onDelete:Cascade)
 /// A one-member flip's call (heads | tails); null for two members.
 call String?
 /// heads | tails, drawn when the flip is made
 outcome String
 /// Set when the flip broke a two-way tie in a loot roll.
 rollId String?
 createdAt DateTime @default(now())
 @@unique([groupId,key])
 @@index([groupId,createdAt])
}
/// A loot roll: members roll 1–100 once each for a drop; the highest wins when an officer closes it.
model GroupLootRoll {
 id String @id @default(cuid())
 groupId String
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 key String
 title String
 /// Silver that comes with the drop, shared among everyone who rolled when the roll closes.
 silver Float @default(0)
 /// The team pot takes one share of that silver.
 potShare Boolean @default(false)
 /// OPEN | CLOSED | CANCELLED
 status String @default("OPEN")
 winnerId String?
 winner User? @relation("RollWinner",fields:[winnerId],references:[id],onDelete:SetNull)
 /// The top roll was tied and the server broke the tie.
 tieBreak Boolean @default(false)
 createdById String?
 createdBy User? @relation("RollOpener",fields:[createdById],references:[id],onDelete:SetNull)
 createdAt DateTime @default(now())
 closedAt DateTime?
 entries GroupLootRollEntry[]
 @@unique([groupId,key])
 @@index([groupId,createdAt])
}
/// One member's roll; the key makes it one roll per member.
model GroupLootRollEntry {
 rollId String
 roll GroupLootRoll @relation(fields:[rollId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 value Int
 createdAt DateTime @default(now())
 @@id([rollId,userId])
}

model CatalogRelease {
 id String @id @default(cuid())
 version String @unique
 sourceUrl String
 rightsReference String
 checksum String
 importedAt DateTime @default(now())
 itemCount Int
 items ItemMetadata[]
}
model ItemMetadata {
 id String @id
 name String
 slot String
 tier Int
 enchantment Int
 itemPower Int?
 abilities Json
 recipe Json?
 releaseId String
 release CatalogRelease @relation(fields:[releaseId],references:[id],onDelete:Restrict)
 active Boolean @default(true)
 @@index([active,slot,tier])
 @@index([name])
}

model BuildFavorite {
 userId String
 buildId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 build Build @relation(fields:[buildId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@id([userId,buildId])
 @@index([buildId])
}
model CompositionFavorite {
 userId String
 compositionId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 composition Composition @relation(fields:[compositionId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@id([userId,compositionId])
 @@index([compositionId])
}
model BuildVote {
 userId String
 buildId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 build Build @relation(fields:[buildId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@id([userId,buildId])
 @@index([buildId])
}
model ContentComment {
 id String @id @default(cuid())
 authorId String
 author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
 buildId String?
 build Build? @relation(fields:[buildId],references:[id],onDelete:Cascade)
 compositionId String?
 composition Composition? @relation(fields:[compositionId],references:[id],onDelete:Cascade)
 body String @db.Text
 version Int @default(1)
 hiddenAt DateTime?
 deletedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 revisions CommentRevision[]
 reports ContentReport[]
 @@index([buildId,createdAt])
 @@index([compositionId,createdAt])
 @@index([authorId])
}
model CommentRevision {
 id String @id @default(cuid())
 commentId String
 comment ContentComment @relation(fields:[commentId],references:[id],onDelete:Cascade)
 version Int
 body String @db.Text
 createdAt DateTime @default(now())
 @@unique([commentId,version])
}
model ContentReport {
 version Int @default(1)
 id String @id @default(cuid())
 authorId String?
 author User? @relation("ReportAuthor",fields:[authorId],references:[id],onDelete:SetNull)
 buildId String?
 build Build? @relation(fields:[buildId],references:[id],onDelete:Cascade)
 compositionId String?
 composition Composition? @relation(fields:[compositionId],references:[id],onDelete:Cascade)
 commentId String?
 comment ContentComment? @relation(fields:[commentId],references:[id],onDelete:Cascade)
 reason String @db.Text
 status String @default("OPEN")
 reviewerId String?
 reviewer User? @relation("ReportReviewer",fields:[reviewerId],references:[id],onDelete:SetNull)
 reviewNote String @default("") @db.Text
 createdAt DateTime @default(now())
 reviewedAt DateTime?
 @@index([status,createdAt])
}
model ModerationLog {
 id String @id @default(cuid())
 actorId String?
 actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
 targetType String
 targetId String
 action String
 reason String @db.Text
 createdAt DateTime @default(now())
 @@index([createdAt])
}

model Timer {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 title String
 category String
 status String @default("RUNNING")
 durationMs Int
 dueAt DateTime?
 remainingMs Int?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId,updatedAt])
}

model MarketWatchItem {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 region String
 itemId String
 quality Int @default(1)
 createdAt DateTime @default(now())
 @@unique([userId,region,itemId,quality])
}

model LibraryLike {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  slug String
  createdAt DateTime @default(now())
  @@unique([userId, kind, slug])
  @@index([kind, slug])
}

/// A library build saved to the account (private; no public count). `slug` is the build's
/// canonical library key (its slug, or its id when the slug is over 200 characters).
model LibraryFavorite {
  userId String
  slug String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, slug])
}

/// One specialization level on the account (/tools/mastery); level 0 is no row.
model MasteryLevel {
  userId String
  specId String
  level Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  @@id([userId, specId])
}
