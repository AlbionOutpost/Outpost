DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Server-only verified Discord account ID; omit to disable automatic owner assignment.
OUTPOST_OWNER_DISCORD_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional AdSense ownership metadata/seller declaration. This does not activate advertising;
# ad requests stay disabled until a real consent and withdrawal integration is implemented.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Reserved placement IDs for a future consent-backed advertising integration.
NEXT_PUBLIC_ADSENSE_SLOT_HUB=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# Optional public search-engine ownership tokens; leave empty until supplied by the verified owner.
# Production uses matching cloudflare-production GitHub environment variables (vars), then redeploy.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# "true" once the operator is a Kleinunternehmer (§ 19 UStG): the order box and terms then say no VAT is charged.
OPERATOR_SMALL_BUSINESS=

# Supporter tier (Stripe). Leave all four empty to run without billing: the Supporter page
# explains that nothing is for sale yet. Set all four or none. The publishable key (pk_test_/pk_live_)
# is not secret: the server hands it to Stripe.js in the order form.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SUPPORTER=
STRIPE_PUBLISHABLE_KEY=
