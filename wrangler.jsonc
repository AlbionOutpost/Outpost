{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "albionoutpost-web",
  "main": "cloudflare/web/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "vars": { "OUTPOST_RUNTIME": "cloudflare" },
  "services": [{ "binding": "OUTPOST_DATA", "service": "albionoutpost-data" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ratelimits": [
    { "name": "EDGE_REQUESTS", "namespace_id": "4101", "simple": { "limit": 240, "period": 60 } },
    { "name": "EDGE_SEARCH", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "EDGE_ITEM_PRICES", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } },
    { "name": "EDGE_MARKET", "namespace_id": "4104", "simple": { "limit": 20, "period": 60 } },
  ],
  "limits": { "cpu_ms": 10000 },
  "migrations": [{ "tag": "v1-sessions", "new_sqlite_classes": ["OutpostSession"] }],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
