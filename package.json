{
  "name": "albion-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cloudflare": "node scripts/cloudflare.mjs",
    "cloudflare:status": "node scripts/cloudflare.mjs status",
    "dev": "next dev",
    "build": "prisma generate && node --import tsx scripts/build-sitemap.ts && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test e2e/homepage.spec.ts e2e/outpost.spec.ts e2e/public.spec.ts e2e/qa-security.spec.ts e2e/signin-navigation.spec.ts e2e/account.spec.ts e2e/builds-system.spec.ts e2e/grind-library.spec.ts e2e/group-builds.spec.ts e2e/compositions.spec.ts e2e/groups.spec.ts e2e/team-loot.spec.ts e2e/product-controls.spec.ts e2e/combat-feed.spec.ts e2e/market-research.spec.ts e2e/production.spec.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "tsx scripts/verify-live.ts",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "node scripts/qa-database.mjs",
    "qa:phase": "node scripts/qa-phase.mjs",
    "data:sync": "tsx scripts/sync-catalog.ts",
    "data:prepare-snapshot": "tsx scripts/prepare-item-snapshot.ts",
    "db:diagnose": "node scripts/db-diagnose.mjs",
    "data:audit": "node --import tsx scripts/audit-game-data.ts",
    "data:source": "node --import tsx scripts/sync-game-source.ts",
    "cloudflare:security": "node scripts/cloudflare-security.mjs",
    "cloudflare:mail": "node scripts/cloudflare-mail.mjs",
    "cloudflare:dnssec": "node scripts/cloudflare-dnssec.mjs",
    "cloudflare:d1:schema": "node scripts/cloudflare-d1-schema.mjs",
    "cloudflare:d1:provision": "node scripts/cloudflare-d1-provision.mjs",
    "discord:status": "node scripts/discord-setup.mjs",
    "discord:setup": "node scripts/discord-setup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "ioredis": "^5.6.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.55.0",
    "@prisma/adapter-d1": "6.19.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.6.0",
    "prisma": "^6.19.0",
    "rclone.js": "0.6.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "rclone.js": {
      "adm-zip": "0.6.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
