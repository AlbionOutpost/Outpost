{
  "name": "albion-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "tsx scripts/verify-live.ts",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "node scripts/qa-database.mjs",
    "qa:phase": "node scripts/qa-phase.mjs",
    "data:sync": "tsx scripts/sync-catalog.ts",
    "data:prepare-snapshot": "tsx scripts/prepare-item-snapshot.ts",
    "db:diagnose": "node scripts/db-diagnose.mjs",
    "data:audit": "node --import tsx scripts/audit-game-data.ts",
    "data:source": "node --import tsx scripts/sync-game-source.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "ioredis": "^5.6.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource/barlow-condensed": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.6.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
