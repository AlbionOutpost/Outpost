{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "albionoutpost-data",
  "main": "worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "@/lib/database-driver": "./context.ts",
    "@/lib/prisma-runtime": "../generated/prisma/wasm.js",
    "@prisma/client": "../generated/prisma/wasm.js",
  },
  "durable_objects": {
    "bindings": [
      { "name": "DATABASE", "class_name": "OutpostDatabase" },
      { "name": "BUDGETS", "class_name": "AbuseBudget" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OutpostDatabase", "AbuseBudget"] }],
  "d1_databases": [
    {
      "binding": "CATALOG",
      "database_name": "albionoutpost-staging",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
