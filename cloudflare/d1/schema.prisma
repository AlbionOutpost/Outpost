// Generated migration candidate; not the active application schema.
// Regenerate with node scripts/cloudflare-d1-schema.mjs.
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("D1_MIGRATION_URL")
}
model User {
 marketWatchItems MarketWatchItem[]
 timers Timer[]
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  role String @default("USER")
  region String @default("europe")
  characterName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  compositions Composition[]
  ownedGroups Group[]
  memberships GroupMember[]
  builds Build[]
  accounts Account[]
  sessions Session[]
  groupRequests GroupMembershipRequest[]
  groupRsvps EventRSVP[]

  authoredAnnouncements GroupAnnouncement[]
  authoredGroupEvents GroupEvent[]
  authoredGroupBuilds GroupBuild[]
  issuedGroupInvites GroupInvitation[]

  savedScenarios SavedScenario[]

  buildFavorites BuildFavorite[]
  compositionFavorites CompositionFavorite[]
  buildVotes BuildVote[]
  comments ContentComment[]
  reports ContentReport[] @relation("ReportAuthor")
  reviewedReports ContentReport[] @relation("ReportReviewer")
  moderationLogs ModerationLog[]

}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}

enum BuildVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}
model Build {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title String
  description String
  contentType String
  region String
  visibility BuildVisibility @default(PRIVATE)
  playerCount Int @default(1)
  recommendedIP Int @default(0)
  strategy String
  patchNotes String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  equipmentSets Json @default("[]")
  equipment BuildEquipment[]
  versions BuildVersion[]
  @@index([visibility, updatedAt])
  @@index([authorId, updatedAt])
  groupSnapshots GroupBuild[]

 hiddenAt DateTime?
 comments ContentComment[]
 reports ContentReport[]
 favorites BuildFavorite[]
 votes BuildVote[]

}
model BuildEquipment {
  id String @id @default(cuid())
  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  slot String
  itemId String
  quality Int
  abilities String
  alternatives String
  @@unique([buildId, slot])
  abilitySelections Json @default("{}")
  alternativeItemIds Json @default("[]")

}
model BuildVersion {
  id String @id @default(cuid())
  buildId String
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  version Int
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([buildId, version])
}

enum GroupRole {
 OWNER
 ADMIN
 OFFICER
 MEMBER
}
enum ContentVisibility {
 PUBLIC
 PRIVATE
 GROUP
}
model Group {
 id String @id @default(cuid())
 name String
 slug String @unique
 description String
 region String
 visibility String @default("PRIVATE")
 ownerId String
 owner User @relation(fields:[ownerId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 members GroupMember[]
 compositions Composition[]
 @@index([visibility,updatedAt])
 @@index([ownerId])
  invitations GroupInvitation[]
  requests GroupMembershipRequest[]
  announcements GroupAnnouncement[]
  events GroupEvent[]
  builds GroupBuild[]

}
model GroupMember {
 groupId String
 userId String
 role GroupRole @default(MEMBER)
 joinedAt DateTime @default(now())
 group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@id([groupId,userId])
 @@index([userId])
}
model Composition {
 id String @id @default(cuid())
 authorId String
 author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
 groupId String?
 group Group? @relation(fields:[groupId],references:[id],onDelete:Cascade)
 title String
 description String
 region String
 contentType String
 visibility ContentVisibility @default(PRIVATE)
 slots Json
 notes String
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 versions CompositionVersion[]
 @@index([authorId,updatedAt])
 @@index([visibility,updatedAt])
 @@index([groupId,updatedAt])
  events GroupEvent[]

 hiddenAt DateTime?
 comments ContentComment[]
 reports ContentReport[]
 favorites CompositionFavorite[]

}
model CompositionVersion {
 id String @id @default(cuid())
